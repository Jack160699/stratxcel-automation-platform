{
  "mcpServers": {
    "stratxcel-browser": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--user-data-dir",
        "D:/pw-profile",
        "--output-dir",
        "D:/pw-output",
        "--viewport-size",
        "1440x900"
      ],
      "env": {
        "NPM_CONFIG_CACHE": "D:\\npm-cache",
        "PLAYWRIGHT_BROWSERS_PATH": "D:\\ms-playwright"
      }
    },
    "stratxcel-github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "stratxcel-aws": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-aws"
      ],
      "env": {
        "AWS_REGION": "ap-south-1"
      }
    },
    "stratxcel-postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${SUPABASE_DB_URL}"
      ]
    },
    "stratxcel-google-drive": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-drive"
      ]
    }
  }
}