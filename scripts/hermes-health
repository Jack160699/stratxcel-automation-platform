#!/usr/bin/env bash
# Checks the local Hermes container's /health endpoint.
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${HERMES_PORT:-4100}"

if command -v curl >/dev/null 2>&1; then
  curl -sf "http://127.0.0.1:${PORT}/health" && echo "" && echo "Hermes is healthy." || {
    echo "Hermes did not respond healthy on port ${PORT}." >&2
    exit 1
  }
else
  echo "curl is not available — cannot check Hermes health automatically." >&2
  exit 1
fi
