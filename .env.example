# Supabase — project API settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Google OAuth / Google One Tap Client ID (Public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Analytics 4 Measurement ID (Public) — format G-XXXXXXXXXX, from the
# GA4 property's Web stream. Leave blank to disable GA entirely: the tag is
# only rendered when this is set to a well-formed measurement ID, so Preview
# and local dev send no analytics traffic. This is a public identifier, not a
# secret — the GA4 Data API credentials it would take to *read* reports are
# deliberately not part of this app.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (Public) — the `content`
# value of the <meta name="google-site-verification"> tag Search Console
# issues. Rendered from app/layout.tsx only when set. Public by design; it
# proves ownership and grants no access on its own.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only — Supabase service-role key. Never expose to the browser.
# Required for Social Autopilot (token storage, OAuth callback, worker).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — legacy lead-analytics backend for the admin dashboard panel
# BOT_BACKEND_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------------
# Search & Discovery — Google Search Console + GA4 tenant integration
# (server-only; dedicated Google Cloud OAuth client, separate from Google
# login/One Tap and from the Drive integration's own client, so consent-
# screen scope review and revocation blast radius stay scoped to this
# feature — see packages/search-discovery/src/google/oauth.ts)
# ---------------------------------------------------------------------------
GOOGLE_SEARCH_OAUTH_CLIENT_ID=
GOOGLE_SEARCH_OAUTH_CLIENT_SECRET=

# Signs/verifies the tenant-bound OAuth state for this flow only (generate
# with `openssl rand -base64 32`).
SEARCH_GOOGLE_OAUTH_STATE_SECRET=

# Shared with Google Drive / BYOK — refresh tokens for this feature are
# encrypted at rest via the existing vault (packages/byok), not a new
# secret. 32-byte key, hex-encoded (64 hex chars). Required if not already
# set for Drive.
BYOK_VAULT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Social Autopilot — safety secrets (server-only, generate with `openssl rand -base64 32`)
# ---------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY=

SOCIAL_OAUTH_STATE_SECRET=

# CRON_SECRET (not SOCIAL_CRON_SECRET) — this exact name is required. When set,
# Vercel automatically sends `Authorization: Bearer <value>` to the paths
# listed under "crons" in vercel.json. The admin's manual "Run worker now"
# button does NOT use this — it calls the worker in-process server-side.
CRON_SECRET=

# Social Autopilot — Meta app credentials (server-only)
# Instagram API with Instagram Login
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Facebook Login (Pages)
META_APP_ID=
META_APP_SECRET=
# Threads API
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=

# Webhook subscription verify token — set to any random string here, then
# enter the SAME value as the "Verify Token" when configuring the webhook
# subscription in the Meta App Dashboard. Callback URL:
#   https://stratxcel.vercel.app/api/social/webhooks/{instagram|facebook|threads}
META_WEBHOOK_VERIFY_TOKEN=

# Optional — enables the Agent's reasoning (tool-calling loop). Without one
# of these, the Agent honestly reports "not configured" instead of
# fabricating responses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# AI Provider Router V1 (@stratxcel/ai-runtime) — names only, server-only
# Defaults match the approved catalog; overrides are operational escape hatches.
# ---------------------------------------------------------------------------
# AI_ROUTER_ENABLED=1
# AI_PAID_FALLBACK_ENABLED=1
# AI_GOOGLE_CHEAP_MODEL=gemini-3.5-flash-lite
# AI_GOOGLE_STANDARD_MODEL=gemini-3.6-flash
# AI_OPENAI_NANO_MODEL=gpt-5.4-nano
# AI_OPENAI_MINI_MODEL=gpt-5.4-mini
# AI_OPENAI_LUNA_MODEL=gpt-5.6-luna
# AI_OPENAI_TERRA_MODEL=gpt-5.6-terra
# AI_OPENAI_SOL_MODEL=gpt-5.6-sol
# AI_GOOGLE_IMAGE_FAST_MODEL=gemini-3.1-flash-lite-image
# AI_GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
# AI_GOOGLE_IMAGE_PREMIUM_MODEL=gemini-3-pro-image
# AI_OPENAI_IMAGE_MODEL=gpt-image-2
# AI_GOOGLE_VIDEO_LITE_MODEL=veo-3.1-lite-generate-preview
# AI_GOOGLE_VIDEO_FAST_MODEL=veo-3.1-fast-generate-preview
# AI_GOOGLE_VIDEO_PREMIUM_MODEL=veo-3.1-generate-preview
# AI_MONTHLY_BUDGET_STARTER_USD=8.40
# AI_MONTHLY_BUDGET_GROWTH_USD=17.30
# AI_MONTHLY_BUDGET_BUSINESS_USD=36.70
# AI_MONTHLY_BUDGET_SCALE_USD=68.20
# AI_PROVIDER_TIMEOUT_MS=45000
# AI_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=5
# AI_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_MS=60000
# AI_LIVE_SMOKE_TEST=0
# AI_LIVE_IMAGE_SMOKE=0

# ---------------------------------------------------------------------------
# Automatic Business Audit Engine V1 (server-only; fail-closed)
# Keep automation disabled until its additive migration, worker, and preview
# checks have passed. These flags never initiate a payment or provider call by
# themselves.
# ---------------------------------------------------------------------------
# AUDIT_AUTOMATION_ENABLED=false
# AUDIT_PREMIUM_FALLBACK_ENABLED=false
# AUDIT_AI_HARD_BUDGET_USD=1.50

# ---------------------------------------------------------------------------
# Razorpay recurring AutoPay (server-only; fail-closed)
# Keep PAYMENTS_RECURRING_SUBSCRIPTIONS_ENABLED unset/false in production.
# Plan IDs are environment-specific — never hardcode live IDs into test.
# ---------------------------------------------------------------------------
# PAYMENTS_SUBSCRIPTIONS_ENABLED=false
# PAYMENTS_RECURRING_SUBSCRIPTIONS_ENABLED=false
# RAZORPAY_INTEGRATION_MODE=disabled
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_TEST_KEY_ID=
# RAZORPAY_TEST_KEY_SECRET=
# RAZORPAY_SUBSCRIPTION_PLAN_STARTER_ID=
# RAZORPAY_SUBSCRIPTION_PLAN_GROWTH_ID=
# RAZORPAY_SUBSCRIPTION_PLAN_BUSINESS_ID=
# Optional: single-use offer that discounts first AutoPay charge by ₹999 Audit credit.
# If unset, eligible Audit credit is deferred as wallet credit after full first charge.
# RAZORPAY_SUBSCRIPTION_AUDIT_CREDIT_OFFER_ID=
