# Supabase — project API settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only — Supabase service-role key. Never expose to the browser.
# Required for Social Autopilot (token storage, OAuth callback, worker).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — legacy lead-analytics backend for the admin dashboard panel
# BOT_BACKEND_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------------
# Social Autopilot — safety secrets (server-only, generate with `openssl rand -base64 32`)
# ---------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_CRON_SECRET=

# Social Autopilot — Meta app credentials (server-only)
# Instagram API with Instagram Login
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Facebook Login (Pages)
META_APP_ID=
META_APP_SECRET=
# Threads API
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=

# Used by the admin "Run worker now" button to call the worker route directly.
NEXT_PUBLIC_SITE_URL=https://stratxcel.vercel.app
