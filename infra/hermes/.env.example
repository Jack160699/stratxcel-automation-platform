# Variable NAMES only. No real value below is a working secret. Never commit
# a filled-in .env for this service — see docs/hermes/SECRETS_AND_SECURITY.md.

# --- Hermes API server (required for every deployment, per docs/hermes/API_CONTRACT.md) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=changeme-generate-a-long-random-value
# API_SERVER_CORS_ORIGINS is intentionally unset — Hermes is never called from a browser.

# --- Model provider (pick ONE path; see docs/hermes/MANUAL_REQUIREMENTS.md item 3) ---
# NOUS_PORTAL_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Terminal backend: docker (see docs/hermes/DEPLOYMENT.md) ---
# No credentials needed here beyond Docker socket access for the host process.

# --- Stratxcel MCP tool server connection (design only — see docs/hermes/SECRETS_AND_SECURITY.md) ---
# A narrowly-scoped connection secret for reaching Stratxcel's own brokered
# tool server. NEVER a Stratxcel admin credential, NEVER a Supabase
# service-role key, NEVER a Vercel/Meta/WhatsApp/Razorpay token.
# STRATXCEL_MCP_URL=
# STRATXCEL_MCP_SECRET=

# --- Explicitly NEVER set here (enforced by docs/hermes/SECRETS_AND_SECURITY.md) ---
# SUPABASE_SERVICE_ROLE_KEY   -- never
# VERCEL_DEPLOY_TOKEN         -- never (only the Stratxcel MCP server holds this)
# META_ACCESS_TOKEN           -- never
# WHATSAPP_ACCESS_TOKEN       -- never
# RAZORPAY_KEY_SECRET         -- never
