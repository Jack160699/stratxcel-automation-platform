# apps/whatsapp-worker — TWO separate long-running processes built from this
# one image: the Meta webhook receiver ("start", default CMD, must ack fast)
# and the async conversation processor ("start:processor"). Deploy them as
# two separate services from the same image with different start commands —
# see infrastructure/workers/README.md. Statically written and reviewed, not
# verified by an actual `docker build` in this session (Docker is not
# installed in this environment).
#
# Build from the REPO ROOT:
#   docker build -f infrastructure/workers/Dockerfile.whatsapp-worker -t stratxcel-whatsapp-worker .
FROM node:24-alpine AS base
WORKDIR /repo

COPY package.json package-lock.json ./
COPY packages packages
COPY apps apps

RUN npm ci --omit=dev

WORKDIR /repo/apps/whatsapp-worker
ENV NODE_ENV=production
# 8081 = webhook receiver ("start"); 8084 = processor's own /health ("start:processor")
EXPOSE 8081 8084
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.HEALTHCHECK_PORT||8081)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Override with `--entrypoint "npm run start:processor"` (or platform-equivalent) for the processor service.
CMD ["npm", "start"]
